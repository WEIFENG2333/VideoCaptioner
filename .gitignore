# Project-specific
/resource/bin/*
# macsysaudio：macOS 系统声音 helper（arm64 + x86_64 universal），源码在 native/，体积小、
# 连同产物入库（clone 即用）。voxgate / ffmpeg 体积大且多平台，走
# core/download/dependencies.py 下载，不入库。
!/resource/bin/macsysaudio
/AppData/
/work-dir/
/*.srt
/*.mp4
*.log

